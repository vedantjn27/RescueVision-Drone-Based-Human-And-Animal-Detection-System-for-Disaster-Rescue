<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
    <name>Rescue Locations</name>
    <description>Detected humans and animals requiring rescue</description>
    
    <Style id="humanIcon">
        <IconStyle>
            <color>ff0000ff</color>
            <scale>1.2</scale>
            <Icon>
                <href>http://maps.google.com/mapfiles/kml/shapes/man.png</href>
            </Icon>
        </IconStyle>
    </Style>
    
    <Style id="animalIcon">
        <IconStyle>
            <color>ff00ffff</color>
            <scale>1.0</scale>
            <Icon>
                <href>http://maps.google.com/mapfiles/kml/shapes/placemark_circle.png</href>
            </Icon>
        </IconStyle>
    </Style>
    
    <Placemark>
        <name>Human #1</name>
        <description>
            Detection ID: 1
            Type: human
            Priority: 1
            Status: PENDING
            Time: 2026-02-26T10:07:47.389583
            Altitude: 51.6m
        </description>
        <styleUrl>#humanIcon</styleUrl>
        <Point>
            <coordinates>77.594665,12.970566,51.6</coordinates>
        </Point>
    </Placemark>
    
    <Placemark>
        <name>Human #2</name>
        <description>
            Detection ID: 2
            Type: human
            Priority: 1
            Status: PENDING
            Time: 2026-02-26T10:07:51.132044
